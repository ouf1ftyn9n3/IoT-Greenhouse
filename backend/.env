APP_NAME="Greenhouse Backend"

# База данных - используем SQLite для разработки
DATABASE_URL="sqlite:///./data/dev.db"

# JWT настройки - можно оставить как есть для разработки
JWT_SECRET="super-secret-jwt-key-for-development-change-this-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Фронтенд - ВАЖНО! Для ручного запуска фронтенд на порту 8010
FRONTEND_ALLOWED_ORIGIN="http://localhost:8010,http://127.0.0.1:8010"

# ThingsBoard - пока можно оставить закомментированным или с пустыми значениями
THINGSBOARD_URL="http://localhost:8080"
THINGSBOARD_TOKEN=""
THINGSBOARD_DEVICE_CHECK_PATH="api/device/{serial_number}"
THINGSBOARD_USERNAME="tenant@thingsboard.org"
THINGSBOARD_PASSWORD="tenant"
THINGSBOARD_LOGIN_PATH="/api/auth/login"
THINGSBOARD_REQUEST_TIMEOUT=10.0
THINGSBOARD_TELEMETRY_PATH="/api/plugins/telemetry/DEVICE/{device_id}/values/timeseries"
THINGSBOARD_TELEMETRY_KEYS="temperature,humidity,windowPosition,status,position"
THINGSBOARD_TELEMETRY_LIMIT=120APP_NAME="Greenhouse Backend"

